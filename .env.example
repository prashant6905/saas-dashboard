# ==============================================================================
# Command Center — Production & Local Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# In production platforms (Vercel, AWS Amplify, Docker, Railway, Cloud Run),
# configure these variables in the environment settings dashboard.
# DO NOT commit real secrets or service role keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public Authentication & Client Config
# ------------------------------------------------------------------------------
# Your Supabase Project URL and Public Anonymous Key (found in Supabase Settings -> API).
# If unconfigured or using mock values, the application gracefully operates in
# local standalone evaluation mode with deterministic demo credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. Cryptographic Session Token Secret (HMAC-SHA256)
# ------------------------------------------------------------------------------
# A high-entropy random secret key (minimum 32 characters) used to cryptographically
# sign and verify session authentication cookies (cc_auth_session).
# Generate a secure key using: openssl rand -base64 32
SESSION_SECRET=replace-with-a-secure-random-256-bit-session-secret-string

# ------------------------------------------------------------------------------
# 3. Canonical Site URL (Auth Redirects & CORS)
# ------------------------------------------------------------------------------
# The canonical public URL where Command Center is deployed.
# Used for authentication callback redirects, password recovery links, and absolute paths.
# Local development default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://commandcenter.yourdomain.com

# ------------------------------------------------------------------------------
# 4. Optional Server-Only Credentials
# ------------------------------------------------------------------------------
# (Optional) Supabase Service Role Key for elevated backend operations.
# NEVER prefix with NEXT_PUBLIC_. Keep strictly confidential.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
